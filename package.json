{
  "name": "wampums",
  "version": "3.1.0",
  "description": "Wampums project",
  "main": "api.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "npm run start & npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "analyze": "ANALYZE=true vite build",
    "start": "node api.js",
    "start:prod": "NODE_ENV=production node api.js",
    "postinstall": "npm rebuild bcrypt --build-from-source",
    "test": "jest",
    "test:stories": "jest test/user-stories",
    "test:scout-year": "jest test/scout-year-rollback.integration.test.js test/erasure.integration.test.js test/alumni.integration.test.js test/transfer.integration.test.js test/organization-creation.integration.test.js",
    "lint:api-version": "node scripts/modernization/check-api-version.js",
    "lint:duplicate-mounts": "node scripts/modernization/check-duplicate-mounts.js",
    "lint:spa-files": "node scripts/modernization/check-spa-files.js",
    "lint:spa-console": "node scripts/modernization/check-spa-source-pattern.js console",
    "lint:spa-innerhtml": "node scripts/modernization/check-spa-source-pattern.js innerhtml",
    "lint:sql-params": "node scripts/modernization/check-sql-params.js",
    "lint:non-versioned-mounts": "node scripts/modernization/check-non-versioned-mounts.js",
    "lint:i18n-parity": "node scripts/modernization/check-i18n-parity.js",
    "lint:api-contracts": "node scripts/modernization/check-spa-api-contracts.js",
    "test:quality": "jest --runInBand --testPathIgnorePatterns=\"/node_modules/|/mobile/|test/api.test.js|test/api-consistency.test.js|test/security.test.js|test/permission-slips.security.test.js|test/landing-host.test.js|test/local-groups.test.js|test/resources.equipment.test.js|tests/manual_budget_test.js\"",
    "catalog:load:oas": "node scripts/load-oas-catalog.js",
    "catalog:load": "node scripts/load-oas-catalog.js",
    "db:local:setup": "node scripts/setup-local-database.js",
    "db:install": "node scripts/setup-local-database.js",
    "db:migrate:base": "node scripts/run-base-migrations.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@googleapis/chat": "^44.6.0",
    "@supabase/supabase-js": "^2.110.7",
    "@veryfi/veryfi-sdk": "^1.4.6",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "compression": "^1.8.0",
    "cors": "^2.8.6",
    "dexie": "^4.3.0",
    "dompurify": "^3.4.12",
    "dotenv": "^17.3.1",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.2.1",
    "glob": "^13.0.5",
    "google-auth-library": "^10.5.0",
    "gray-matter": "^4.0.3",
    "heic-convert": "^2.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "marked": "^18.0.6",
    "mindee": "^5.5.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "openai": "^6.46.0",
    "pg": "^8.18.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.0",
    "sib-api-v3-sdk": "^8.5.0",
    "socket.io": "^4.8.1",
    "stripe": "^22.3.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.2.0",
    "web-push": "^3.6.7",
    "winston": "^3.17.0",
    "workbox-cacheable-response": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "babel-jest": "^30.2.0",
    "fake-indexeddb": "^6.2.5",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/test/setupJest.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/jest-conditional-helpers.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/mobile/"
    ],
    "transform": {
      "^.*/spa/.+\\.js$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ]
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(?:@supabase/supabase-js|@googleapis/chat|openai|@veryfi/veryfi-sdk|@whiskeysockets/baileys)/)"
    ]
  },
  "overrides": {
    "serialize-javascript": "7.0.3"
  }
}
