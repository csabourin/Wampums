# Database Configuration
DB_USER=your_db_user
DB_HOST=your_db_host
DB_NAME=your_db_name
DB_PASSWORD=your_db_password
DB_PORT=5432

# Alternative: full PostgreSQL URL (takes precedence over DB_* values)
# For a local peer-authenticated database:
# DATABASE_URL=postgresql:///wampums?host=/var/run/postgresql
# For a remote managed PostgreSQL database:
# DATABASE_URL=postgresql://user:password@host:port/database
# Legacy deployment fallback. Prefer DATABASE_URL; while migrating an existing
# environment, its former SB_URL value may be retained without an outage.
# SB_URL=postgresql://user:password@host:port/database

# Invitation password seeded by `npm run db:local:setup` for local registration.
LOCAL_REGISTRATION_PASSWORD=replace_with_a_local_registration_password

# Database SSL Configuration
# By default, SSL certificate validation is ENABLED for security
# Only set this to 'true' in development environments if you need to disable SSL validation
# DB_SSL_DISABLED=false

# JWT Secret - REQUIRED
# Generate a secure secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# WARNING: Never commit the actual secret to version control
JWT_SECRET_KEY=your_secret_key_here_REPLACE_WITH_RANDOM_64_BYTE_HEX

# Web Push Notifications (VAPID)
VAPID_PRIVATE=your_vapid_private_key
VAPID_PUBLIC=BPsOyoPVxNCN6BqsLdHwc5aaNPERFO2yq-xF3vqHJ7CdMlHRn5EBPnxcoOKGkeIO1_9zHnF5CRyD6RvLlOKPcTE

# Email Configuration (Brevo - formerly Sendinblue)
# Brevo API Key for transactional emails
BREVO_API_KEY=your_brevo_api_key
# Alternative environment variable name
# BREVO_KEY=your_brevo_api_key

# Brevo SMTP Configuration (fallback email sending method)
BREVO_SMTP_KEY=your_brevo_smtp_key
BREVO_SMTP_USER=your-smtp-login@smtp-brevo.com

# Email sender configuration
EMAIL_FROM=info@wampums.app
EMAIL_FROM_NAME=Wampums

# SendGrid (for email - alternative, not currently in use)
SENDGRID_API_KEY=your_sendgrid_api_key

# WhatsApp Integration (Twilio)
# Get credentials from: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Your Twilio WhatsApp-enabled phone number (format: whatsapp:+1234567890)
TWILIO_WHATSAPP_FROM=whatsapp:+1234567890

# Google Chat Integration
# Optional: Configure logging level for Google Chat (debug, info, warn, error)
GOOGLE_CHAT_LOG_LEVEL=info
# Optional: Custom log file name for Google Chat logs
GOOGLE_CHAT_LOG_FILE=google-chat.log
# Optional: Enable/disable console logs for Google Chat (default: true)
GOOGLE_CHAT_CONSOLE_LOGS=true
# Note: Service account credentials are stored in the database per organization
# To configure Google Chat:
#   1. Create a Google Cloud Project at https://console.cloud.google.com
#   2. Enable the Google Chat API
#   3. Create a Service Account and download the JSON key
#   4. Use the /api/google-chat/config endpoint to upload credentials
#   5. Create a Google Chat Space and add your bot
#   6. Register the Space using /api/google-chat/spaces endpoint

# Server Configuration
PORT=3000
NODE_ENV=development
# Public base URL of this deployment (used in password reset emails).
# Set this to the canonical HTTPS URL so reset links always point to the right domain.
# If not set, the server will look up the domain from the organization_domains table.
# Example: APP_URL=https://scouts.example.com
APP_URL=

# Railway S3-compatible bucket configuration
# Used for equipment inventory photo uploads. In Railway, connect the bucket to
# the application service and auto-inject its AWS-compatible credentials.
AWS_ENDPOINT_URL=https://storage.railway.app
AWS_ACCESS_KEY_ID=your_bucket_access_key_id
AWS_SECRET_ACCESS_KEY=your_bucket_secret_access_key
AWS_S3_BUCKET_NAME=your-globally-unique-bucket-name
AWS_DEFAULT_REGION=auto
# Railway's Credentials tab specifies either "virtual" or "path".
AWS_S3_URL_STYLE=virtual
# Temporary browser URL lifetime (seconds). Stored database values never expire.
RAILWAY_S3_SIGNED_URL_TTL_SECONDS=3600

# Stripe Payment Configuration
# Get credentials from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Webhook signing secret from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Frontend Environment Variables (prefixed with VITE_)
# These are exposed to the client-side code
VITE_API_URL=http://localhost:3000
VITE_APP_NAME=Wampums Scout Management
# Browser URL used when the development API redirects HTML navigation to Vite.
DEV_WEB_ORIGIN=http://localhost:5173
# Stripe publishable key for frontend
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
