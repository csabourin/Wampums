<%# Site footer and demo request dialog, copied from the home pages (landing/en|fr/index.html). %>
<% if (lang === 'fr') { %>
    <footer class="site-footer">
      <div class="shell">
        <div class="footer-grid">
          <div class="footer-brand">
            <a class="brand" href="/fr/">
              <img src="/images/defaultImage.webp" width="40" height="40" alt="" />
              <span>Wampums</span>
            </a>
            <p>Les scouts au bout des doigts. Conçue au Canada pour les unités qui se réunissent chaque semaine : simple, bilingue et prête à l'emploi.</p>
            <p class="contact"><a href="mailto:hello@wampums.app">hello@wampums.app</a></p>
          </div>
          <nav aria-labelledby="footer-features">
            <h2 id="footer-features">Fonctionnalités</h2>
            <ul>
              <li><a href="/fr/fonctionnalites/presences/">Présences</a></li>
              <li><a href="/fr/fonctionnalites/badges/">Badges</a></li>
              <li><a href="/fr/fonctionnalites/communication/">Communication</a></li>
              <li><a href="/fr/fonctionnalites/formulaires/">Formulaires</a></li>
              <li><a href="/fr/fonctionnalites/logistique/">Logistique</a></li>
              <li><a href="/fr/fonctionnalites/finances/">Finances</a></li>
            </ul>
          </nav>
          <nav aria-labelledby="footer-modules">
            <h2 id="footer-modules">Modules</h2>
            <ul>
              <li><a href="/fr/modules/finance/">Finances</a></li>
              <li><a href="/fr/modules/fundraising/">Collectes de fonds</a></li>
              <li><a href="/fr/modules/on-site/">Sur place</a></li>
              <li><a href="/fr/modules/offline/">Hors ligne</a></li>
              <li><a href="/fr/modules/medications/">Médicaments</a></li>
              <li><a href="/fr/modules/carpool/">Covoiturage</a></li>
            </ul>
          </nav>
          <nav aria-labelledby="footer-compare">
            <h2 id="footer-compare">Comparer</h2>
            <ul>
              <li><a href="/fr/comparer/wampums-vs-tableurs/">vs Tableurs</a></li>
              <li><a href="/fr/comparer/wampums-vs-sporteasy/">vs SportEasy</a></li>
              <li><a href="/fr/comparer/wampums-vs-trooptrack/">vs TroopTrack</a></li>
              <li><a href="/fr/comparer/wampums-vs-scoutbook/">vs Scoutbook</a></li>
              <li><a href="/fr/comparer/wampums-vs-scoutstracker/">vs ScoutsTracker</a></li>
            </ul>
          </nav>
          <nav aria-labelledby="footer-learn">
            <h2 id="footer-learn">Ressources</h2>
            <ul>
              <li><a href="/fr/administrateurs/">Pour les administrateurs</a></li>
              <li><a href="/fr/districts/">Pour les districts</a></li>
              <li><a href="/fr/qui-est-derriere-wampums/">Qui est derrière Wampums</a></li>
              <li><a href="/fr/faq/">FAQ</a></li>
              <li><a href="/fr/blogue/">Blogue</a></li>
              <li><a href="/fr/confidentialite/">Politique de confidentialité</a></li>
              <li><a href="<%= enPath %>" lang="en-CA" hreflang="en-CA">English version</a></li>
            </ul>
          </nav>
        </div>
        <div class="footer-base">
          <span>© Wampums</span>
          <span>Conçue au Canada · Français et anglais</span>
        </div>
      </div>
    </footer>

    <div id="demoModal" class="modal" hidden>
      <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="modalTitle" aria-describedby="modalIntro">
        <div class="modal-header">
          <h2 id="modalTitle">Demander une démo</h2>
          <button type="button" class="modal-close" aria-label="Fermer" data-close-modal>
            <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#i-x" /></svg>
          </button>
        </div>
        <p class="modal-intro" id="modalIntro">Parlez-nous un peu de votre unité : nous vous répondrons pour la configurer. Seuls le nom et le courriel sont obligatoires.</p>

        <div class="form-success" id="formSuccess" role="status" tabindex="-1" hidden><p>Merci, votre demande est envoyée. Nous vous écrirons pour configurer votre unité.</p><p>En attendant, visitez l'unité exemple, en parent ou en animateur.</p><a class="btn btn--teal" href="https://demo.wampums.app" data-track="sample_unit">Explorer l'unité exemple</a></div>
        <p class="form-status" id="formStatus" role="alert" hidden data-generic="Votre demande n'a pas pu être envoyée. Vérifiez votre connexion et réessayez, ou écrivez à hello@wampums.app." data-busy="Trop de demandes depuis cette connexion. Attendez quelques minutes et réessayez."></p>

        <form id="demoForm" novalidate>
          <div class="form-group">
            <label for="name">Nom</label>
            <input type="text" id="name" name="name" autocomplete="name" required aria-describedby="name-error" />
            <span class="form-error" id="name-error">Entrez votre nom.</span>
          </div>
          <div class="form-group">
            <label for="email">Courriel</label>
            <input type="email" id="email" name="email" autocomplete="email" required aria-describedby="email-error" />
            <span class="form-error" id="email-error">Entrez une adresse courriel comme nom@exemple.com.</span>
          </div>
          <div class="form-group">
            <label for="organization">Unité ou organisme <span class="optional">(facultatif)</span></label>
            <input type="text" id="organization" name="organization" autocomplete="organization" />
          </div>
          <div class="form-group">
            <label for="phone">Téléphone <span class="optional">(facultatif)</span></label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" />
          </div>
          <div class="form-group">
            <label for="unitSize">Nombre de jeunes <span class="optional">(facultatif)</span></label>
            <select id="unitSize" name="unit_size">
              <option value="">Choisir…</option>
              <option value="under_15">Moins de 15</option>
              <option value="15_30">15 à 30</option>
              <option value="31_60">31 à 60</option>
              <option value="over_60">Plus de 60</option>
            </select>
          </div>
          <div class="form-group">
            <label for="currentTool">Ce que vous utilisez aujourd'hui <span class="optional">(facultatif)</span></label>
            <select id="currentTool" name="current_tool">
              <option value="">Choisir…</option>
              <option value="paper">Papier</option>
              <option value="spreadsheets">Tableurs</option>
              <option value="scoutstracker">ScoutsTracker</option>
              <option value="other_app">Une autre application</option>
              <option value="nothing">Rien pour l'instant</option>
            </select>
          </div>
          <div class="form-group">
            <label for="message">Message <span class="optional">(facultatif)</span></label>
            <textarea id="message" name="message" aria-describedby="message-hint"></textarea>
            <span class="form-hint" id="message-hint">Par exemple, ce que vous aimeriez régler en premier.</span>
          </div>
          <div class="honeypot" aria-hidden="true">
            <label for="honeypot">Laissez ce champ vide</label>
            <input type="text" id="honeypot" name="honeypot" tabindex="-1" autocomplete="off" />
          </div>
          <button type="submit" class="btn btn--teal btn-submit" data-busy-label="Envoi en cours…">Envoyer la demande</button>
        </form>
        <p class="modal-alt">Vous préférez regarder d'abord? <a href="https://demo.wampums.app" data-track="sample_unit">Explorez l'unité exemple</a> : en lecture seule, sans inscription.</p>
      </div>
    </div>
<% } else { %>
    <footer class="site-footer">
      <div class="shell">
        <div class="footer-grid">
          <div class="footer-brand">
            <a class="brand" href="/en/">
              <img src="/images/defaultImage.webp" width="40" height="40" alt="" />
              <span>Wampums</span>
            </a>
            <p>Scouts at your fingertips. Built in Canada for units that meet every week: simple, bilingual and ready to use.</p>
            <p class="contact"><a href="mailto:hello@wampums.app">hello@wampums.app</a></p>
          </div>
          <nav aria-labelledby="footer-features">
            <h2 id="footer-features">Features</h2>
            <ul>
              <li><a href="/en/features/attendance/">Attendance</a></li>
              <li><a href="/en/features/badges/">Badges</a></li>
              <li><a href="/en/features/communication/">Communication</a></li>
              <li><a href="/en/features/forms/">Forms</a></li>
              <li><a href="/en/features/logistics/">Logistics</a></li>
              <li><a href="/en/features/finance/">Finance</a></li>
            </ul>
          </nav>
          <nav aria-labelledby="footer-modules">
            <h2 id="footer-modules">Modules</h2>
            <ul>
              <li><a href="/en/modules/finance/">Finance</a></li>
              <li><a href="/en/modules/fundraising/">Fundraising</a></li>
              <li><a href="/en/modules/on-site/">On site</a></li>
              <li><a href="/en/modules/offline/">Offline</a></li>
              <li><a href="/en/modules/medications/">Medications</a></li>
              <li><a href="/en/modules/carpool/">Carpools</a></li>
            </ul>
          </nav>
          <nav aria-labelledby="footer-compare">
            <h2 id="footer-compare">Compare</h2>
            <ul>
              <li><a href="/en/compare/wampums-vs-spreadsheets/">vs Spreadsheets</a></li>
              <li><a href="/en/compare/wampums-vs-sporteasy/">vs SportEasy</a></li>
              <li><a href="/en/compare/wampums-vs-trooptrack/">vs TroopTrack</a></li>
              <li><a href="/en/compare/wampums-vs-scoutbook/">vs Scoutbook</a></li>
              <li><a href="/en/compare/wampums-vs-scoutstracker/">vs ScoutsTracker</a></li>
            </ul>
          </nav>
          <nav aria-labelledby="footer-learn">
            <h2 id="footer-learn">Learn</h2>
            <ul>
              <li><a href="/en/administrators/">For administrators</a></li>
              <li><a href="/en/districts/">For districts</a></li>
              <li><a href="/en/who-is-behind-wampums/">Who is behind Wampums</a></li>
              <li><a href="/en/faq/">FAQ</a></li>
              <li><a href="/en/blog/">Blog</a></li>
              <li><a href="/en/privacy/">Privacy policy</a></li>
              <li><a href="<%= frPath %>" lang="fr-CA" hreflang="fr-CA">Version française</a></li>
            </ul>
          </nav>
        </div>
        <div class="footer-base">
          <span>© Wampums</span>
          <span>Made in Canada · English &amp; French</span>
        </div>
      </div>
    </footer>

    <div id="demoModal" class="modal" hidden>
      <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="modalTitle" aria-describedby="modalIntro">
        <div class="modal-header">
          <h2 id="modalTitle">Request a demo</h2>
          <button type="button" class="modal-close" aria-label="Close" data-close-modal>
            <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#i-x" /></svg>
          </button>
        </div>
        <p class="modal-intro" id="modalIntro">Tell us a little about your unit and we'll write back to set it up. Only your name and email are required.</p>

        <div class="form-success" id="formSuccess" role="status" tabindex="-1" hidden><p>Thank you, your request is on its way. We will write to you to set up your unit.</p><p>Meanwhile, look around the sample unit as a parent or a leader.</p><a class="btn btn--teal" href="https://demo.wampums.app" data-track="sample_unit">Explore the sample unit</a></div>
        <p class="form-status" id="formStatus" role="alert" hidden data-generic="Your request could not be sent. Check your connection and try again, or write to hello@wampums.app." data-busy="Too many requests from this connection. Wait a few minutes and try again."></p>

        <form id="demoForm" novalidate>
          <div class="form-group">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" autocomplete="name" required aria-describedby="name-error" />
            <span class="form-error" id="name-error">Enter your name.</span>
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" autocomplete="email" required aria-describedby="email-error" />
            <span class="form-error" id="email-error">Enter an email address such as name@example.com.</span>
          </div>
          <div class="form-group">
            <label for="organization">Unit or organization <span class="optional">(optional)</span></label>
            <input type="text" id="organization" name="organization" autocomplete="organization" />
          </div>
          <div class="form-group">
            <label for="phone">Phone <span class="optional">(optional)</span></label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" />
          </div>
          <div class="form-group">
            <label for="unitSize">Number of youth <span class="optional">(optional)</span></label>
            <select id="unitSize" name="unit_size">
              <option value="">Choose…</option>
              <option value="under_15">Fewer than 15</option>
              <option value="15_30">15 to 30</option>
              <option value="31_60">31 to 60</option>
              <option value="over_60">More than 60</option>
            </select>
          </div>
          <div class="form-group">
            <label for="currentTool">What you use today <span class="optional">(optional)</span></label>
            <select id="currentTool" name="current_tool">
              <option value="">Choose…</option>
              <option value="paper">Paper</option>
              <option value="spreadsheets">Spreadsheets</option>
              <option value="scoutstracker">ScoutsTracker</option>
              <option value="other_app">Another app</option>
              <option value="nothing">Nothing yet</option>
            </select>
          </div>
          <div class="form-group">
            <label for="message">Message <span class="optional">(optional)</span></label>
            <textarea id="message" name="message" aria-describedby="message-hint"></textarea>
            <span class="form-hint" id="message-hint">For example, what you'd like to fix first.</span>
          </div>
          <div class="honeypot" aria-hidden="true">
            <label for="honeypot">Leave this field empty</label>
            <input type="text" id="honeypot" name="honeypot" tabindex="-1" autocomplete="off" />
          </div>
          <button type="submit" class="btn btn--teal btn-submit" data-busy-label="Sending…">Send request</button>
        </form>
        <p class="modal-alt">Rather look first? <a href="https://demo.wampums.app" data-track="sample_unit">Explore the sample unit</a>: read-only, no sign-up.</p>
      </div>
    </div>
<% } %>
    <script src="/landing.js" defer></script>
