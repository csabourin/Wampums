<%# Site header, as on the home pages. It sits inside the page's dark band (.hero.hero--page). %>
<% const fr = lang === 'fr'; %>
      <header class="site-header">
        <div class="shell topbar">
          <a class="brand" href="/<%= lang %>/">
            <img src="/images/defaultImage.webp" width="40" height="40" alt="" />
            <span>Wampums</span>
          </a>
          <nav class="site-nav" aria-label="<%= fr ? 'Principale' : 'Main' %>">
            <a class="nav-pages" href="/<%= lang %>/#week"><%= fr ? 'Comment ça marche' : 'How it works' %></a>
            <a class="nav-pages" href="/<%= lang %>/#roles"><%= fr ? 'Fonctionnalités' : 'Features' %></a>
            <a class="nav-pages" href="/<%= lang %>/#compare"><%= fr ? 'Comparer' : 'Compare' %></a>
            <a class="nav-pages" href="/<%= lang %>/faq/">FAQ</a>
            <a class="nav-pages" href="<%= fr ? '/fr/blogue/' : '/en/blog/' %>" aria-current="<%= isBlogIndex ? 'page' : 'true' %>"><%= fr ? 'Blogue' : 'Blog' %></a>
            <span class="lang-switch">
              <% if (fr) { %>
              <a href="<%= frPath %>" lang="fr-CA" aria-current="page">FR<span class="sr-only"> — Français</span></a>
              <a href="<%= enPath %>" lang="en-CA" hreflang="en-CA">EN<span class="sr-only"> — English</span></a>
              <% } else { %>
              <a href="<%= frPath %>" lang="fr-CA" hreflang="fr-CA">FR<span class="sr-only"> — Français</span></a>
              <a href="<%= enPath %>" lang="en-CA" aria-current="page">EN<span class="sr-only"> — English</span></a>
              <% } %>
            </span>
          </nav>
        </div>
      </header>
