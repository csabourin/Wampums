# Normalize all text files to LF in the repository and working tree.
# The project standard is Unix line endings (see CLAUDE.md / ESLint linebreak-style).
* text=auto eol=lf

# Explicitly binary assets (never touch line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
*.zip binary
*.jar binary
*.mp3 binary
*.mp4 binary
*.wasm binary
